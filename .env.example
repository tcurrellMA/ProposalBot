# Optional standalone Docker deployment. These paths are on the Docker host;
# mount the Proposal Bot share there first if the files are on server2.
PROPOSAL_BOT_PROJECT_IMAGES_HOST_PATH=/mnt/proposal-bot/Project Images
PROPOSAL_BOT_DATA_HOST_PATH=/mnt/proposal-bot/data
PROPOSAL_BOT_PORT=4181

# Microsoft Entra application registration. Add the exact HTTPS callback URL:
# https://proposalbot.your-company.com/auth/microsoft/callback
MICROSOFT_TENANT_ID=replace-with-your-tenant-id
MICROSOFT_CLIENT_ID=replace-with-your-application-client-id
MICROSOFT_CLIENT_SECRET=replace-with-a-new-client-secret
MICROSOFT_REDIRECT_URI=https://proposalbot.your-company.com/auth/microsoft/callback

# Only these Microsoft 365 accounts can sign in. Separate addresses with commas.
PROPOSAL_BOT_ALLOWED_EMAILS=person.one@your-company.com,person.two@your-company.com
